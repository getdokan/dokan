{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "dokan/store-location-map",
    "version": "1.0.0",
    "title": "Store Location",
    "category": "dokan",
    "description": "Map of where the store is.",
    "keywords": [
        "dokan",
        "store",
        "vendor",
        "location",
        "map",
        "address"
    ],
    "textdomain": "dokan-lite",
    "attributes": {
        "title": {
            "type": "string",
            "default": ""
        },
        "showTitle": {
            "type": "boolean",
            "default": true
        },
        "mapHeight": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true,
            "heading": true
        },
        "typography": {
            "fontSize": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            },
            "textAlign": true
        },
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {},
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}

{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "dokan/store-contact-form",
    "version": "1.0.0",
    "title": "Store Contact Form",
    "category": "dokan",
    "description": "A form letting customers message the vendor.",
    "keywords": [ "dokan", "store", "vendor", "contact", "form", "message" ],
    "textdomain": "dokan-lite",
    "usesContext": [ "dokan/storeId" ],
    "attributes": {
        "storeId": {
            "type": "number",
            "default": 0
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "showTitle": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "color": {
            "text": true,
            "background": true,
            "link": true
        },
        "typography": {
            "fontSize": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            }
        },
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "example": {},
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php"
}

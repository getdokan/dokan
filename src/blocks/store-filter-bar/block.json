{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "dokan/store-filter-bar",
    "version": "1.0.0",
    "title": "Store Filter Bar",
    "category": "dokan",
    "description": "Store count, search, sorting and view controls for the store list.",
    "keywords": [
        "vendor",
        "store",
        "filter",
        "search",
        "dokan"
    ],
    "textdomain": "dokan-lite",
    "attributes": {
        "showStoreCount": {
            "type": "boolean",
            "default": true
        },
        "showSearch": {
            "type": "boolean",
            "default": true
        },
        "showSort": {
            "type": "boolean",
            "default": true
        },
        "showViewToggle": {
            "type": "boolean",
            "default": true
        },
        "storeCountText": {
            "type": "string",
            "default": ""
        },
        "filterButtonText": {
            "type": "string",
            "default": ""
        },
        "sortLabel": {
            "type": "string",
            "default": ""
        },
        "hiddenSortOptions": {
            "type": "array",
            "default": []
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "spacing": {
            "margin": true,
            "padding": true
        },
        "html": false
    },
    "example": {},
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js",
    "render": "file:./render.php"
}

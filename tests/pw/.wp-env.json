{
    "env": {
        "tests": {
            "port": 9999,
            "mysqlPort": 9998,
            "core": null,
            "phpVersion": "7.4",
            "plugins": ["https://github.com/WP-API/Basic-Auth/archive/master.zip", "https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip" ],
            "themes": ["https://downloads.wordpress.org/theme/storefront.latest-stable.zip"],
            "config": {
                "WP_DEBUG": "true",
                "SCRIPT_DEBUG": "true",
                "WP_DEBUG_LOG": "true",
                "WP_DEBUG_DISPLAY": "true"
            },
            "mappings": {
                "wp-data": "./wp-data",
                "wp-content/debug.log": "./wp-data/debug.log",
                "wp-content/mu-plugins": "./mu-plugins",
                "wp-content/plugins/dokan-lite": "../../"
            }
        }
    }
}

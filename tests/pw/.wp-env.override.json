{
    "env": {
        "tests": {
            "port": 9999,
            "mysqlPort": 9998,
            "core": "https://wordpress.org/wordpress-6.9.3.zip",
            "phpVersion": "8.2",
            "plugins": [
                "https://github.com/WP-API/Basic-Auth/archive/master.zip",
                "https://downloads.wordpress.org/plugin/woocommerce.zip"
            ],
            "themes": ["https://downloads.wordpress.org/theme/storefront.zip"],
            "config": {
                "WP_DEBUG": "true",
                "SCRIPT_DEBUG": "false",
                "WP_DEBUG_LOG": "/var/www/html/wp-data/debug.log",
                "WP_DEBUG_DISPLAY": "false",
                "WP_MEMORY_LIMIT": "1024M",
                "WP_MAX_MEMORY_LIMIT": "1024M",
                "WP_AUTO_UPDATE_CORE": false,
                "AUTOMATIC_UPDATER_DISABLED": true
            },
            "mappings": {
                "wp-data": "./wp-data",
                "wp-content/mu-plugins": "./mu-plugins",
                "wp-content/plugins/dokan-lite": "../../",
                "wp-content/plugins/dokan-pro": "../../../dokan-pro",
                "wp-content/plugins/woocommerce-bookings": "../../../woocommerce-bookings",
                "wp-content/plugins/woocommerce-product-addons": "../../../woocommerce-product-addons",
                "wp-content/plugins/woocommerce-simple-auctions": "../../../woocommerce-simple-auctions",
                "wp-content/plugins/woocommerce-subscriptions": "../../../woocommerce-subscriptions",
                "wp-content/plugins/woocommerce-pdf-invoices-packing-slips": "../../../woocommerce-pdf-invoices-packing-slips",
                "wp-content/plugins/dokan-invoice": "../../../dokan-invoice"
            }
        }
    }
}

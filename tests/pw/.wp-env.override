{
    "env": {
        "tests": {
            "plugins": [
                "https://github.com/WP-API/Basic-Auth/archive/master.zip",
                "https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip",
                "../../",
                "../../../../",
                "../../../../woo-plugins/tests/plugins/woocommerce-bookings",
                "../../../../woo-plugins/tests/plugins/woocommerce-product-addons",
                "../../../../woo-plugins/tests/plugins/woocommerce-simple-auctions",
                "../../../../woo-plugins/tests/plugins/woocommerce-subscriptions"
            ],
            "config": {
                "WP_MEMORY_LIMIT": "1024M",
                "WP_MAX_MEMORY_LIMIT": "1024M",
                "WP_DEBUG": "true",
                "WP_DEBUG_LOG": "true",
                "WP_DEBUG_DISPLAY": "false"
            },
            "mappings": {
                "wp-data": "./wp-data",
                "wp-content/debug.log": "./wp-data/debug.log",
                "wp-content/mu-plugins": "./mu-plugins",
                "wp-content/plugins/dokan-lite": "../../",
                "wp-content/plugins/dokan-pro": "../../../../",
                "wp-content/plugins/woocommerce-bookings": "../../../../woo-plugins/tests/plugins/woocommerce-bookings",
                "wp-content/plugins/woocommerce-product-addons": "../../../../woo-plugins/tests/plugins/woocommerce-product-addons",
                "wp-content/plugins/woocommerce-simple-auctions": "../../../../woo-plugins/tests/plugins/woocommerce-simple-auctions",
                "wp-content/plugins/woocommerce-subscriptions": "../../../../woo-plugins/tests/plugins/woocommerce-subscriptions"
            }
        }
    }
}

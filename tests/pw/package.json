{
    "name": "dokan_e2e_api_automation_playwright",
    "version": "1.0.0",
    "description": "dokan e2e & api endpoints test automation using playwright",
    "main": "index.js",
    "scripts": {
        "_comment_step0": "========================================",
        "_comment_step0a": "STEP 0: NPM & PLAYWRIGHT INSTALLATION",
        "_comment_step0b": "========================================",
        "nid": "npm install --include=dev",
        "nip": "npm install --omit=dev",
        "pw:chrome-only": "playwright install chromium",
        "pw:chrome-with-deps": "playwright install --with-deps chromium",
        "pw:chrome-deps-only": "playwright install-deps chromium",
        "pw:browsers": "playwright install",
        "pw:browsers-with-deps": "playwright install --with-deps",
        "pw:browsers-deps-only": "playwright install-deps",

        "_comment_step1": "========================================",
        "_comment_step1a": "STEP 1: START DOCKER (First Time)",
        "_comment_step1b": "Run: npm run start:env",
        "_comment_step1c": "========================================",
        "start:env": "wp-env start",
        "wp-env": "wp-env",

        "_comment_step2": "========================================",
        "_comment_step2a": "STEP 2: SYNC ADMIN CREDENTIALS",
        "_comment_step2b": "Run: npm run sync:admin",
        "_comment_step2c": "Creates WordPress admin from .env file",
        "_comment_step2d": "========================================",
        "sync:admin": "node -e \"require('dotenv').config(); const {execSync} = require('child_process'); const user = process.env.ADMIN || 'admin'; const pass = process.env.ADMIN_PASSWORD || 'password'; const email = user + '@example.com'; console.log('Syncing admin user:', user); let newUserId = 2; try { const result = execSync('npm run wp-env run tests-cli -- wp user create ' + user + ' ' + email + ' --role=administrator --user_pass=' + pass + ' --porcelain', {encoding: 'utf8'}); newUserId = result.trim().split('\\n').pop().trim(); console.log('✅ Admin user created! ID:', newUserId); } catch(e) { console.log('User exists, updating password...'); try { const result = execSync('npm run wp-env run tests-cli -- wp user get ' + user + ' --field=ID', {encoding: 'utf8'}); newUserId = result.trim(); execSync('npm run wp-env run tests-cli -- wp user update ' + user + ' --user_pass=' + pass + ' --skip-email', {stdio: 'inherit'}); console.log('✅ Admin password updated!'); } catch(e2) { console.log('⚠️ Admin sync had issues'); } } try { execSync('npm run wp-env run tests-cli -- bash -c \\\"wp post list --post_type=page,post --author=1 --format=ids | xargs -r wp post update --post_author=' + newUserId + '\\\"', {stdio: 'inherit'}); console.log('✅ Reassigned pages/posts to new admin'); execSync('npm run wp-env run tests-cli -- wp user delete admin --yes 2>/dev/null', {stdio: 'inherit'}); console.log('✅ Default admin removed'); } catch(e) { console.log('Default admin already removed or pages already reassigned'); }\"",

        "_comment_step3": "========================================",
        "_comment_step3a": "STEP 3: RUN COMPLETE SETUP",
        "_comment_step3b": "Run: npm run docker:setup",
        "_comment_step3c": "Activates plugins, creates users, test data",
        "_comment_step3d": "Expected: 65 passed, 1 skipped",
        "_comment_step3e": "========================================",
        "docker:setup": "npx playwright test --project=site_setup --project=auth_setup --project=e2e_setup",
        "docker:site:setup": "npx playwright test --project=site_setup",
        "docker:auth:setup": "npx playwright test --project=auth_setup",
        "docker:env:setup": "npx playwright test --project=e2e_setup",

        "_comment_step4": "========================================",
        "_comment_step4a": "STEP 4: RUN TESTS",
        "_comment_step4b": "Run: npm run test:e2e (or test:api)",
        "_comment_step4c": "========================================",
        "test": "npx playwright test",
        "test:e2e": "NO_SETUP=true npx playwright test --project=e2e_tests",
        "test:api": "npx playwright test --project=api_tests --config=api.config.ts",
        "test:e2e:pro": "DOKAN_PRO=true npx playwright test --project=e2e_tests",
        "test:api:pro": "DOKAN_PRO=true npx playwright test --project=api_tests --config=api.config.ts",

        "_comment_test_modes": "=== Test Execution Modes ===",
        "test:e2e:coverage": "npx playwright test --project=coverage_report --reporter=null",
        "test:e2e:headed": "npx playwright test --project=e2e_tests --headed",
        "test:e2e:ui": "npx playwright test --project=e2e_tests --ui",
        "test:e2e:debug": "npx playwright test --project=e2e_tests --debug",
        "test:codegen": "playwright codegen",

        "_comment_reporting": "=== Test Reporting ===",
        "test:report": "npx playwright show-report",
        "test:trace": "npx playwright show-trace trace.zip",
        "merge:report": "npx playwright merge-reports --reporter html",
        "allure:generate": "allure generate playwright-report/allure-report -o allure-report  --clean",
        "allure:open": "allure open allure-report",

        "_comment_docker_daily": "========================================",
        "_comment_docker_daily_a": "DAILY USAGE (After Initial Setup)",
        "_comment_docker_daily_b": "========================================",
        "docker:start": "npm run start:env && npm run sync:admin",
        "stop:env": "wp-env stop",
        "restart:env": "wp-env start",

        "_comment_docker_reset": "========================================",
        "_comment_docker_reset_a": "RESET & TROUBLESHOOTING",
        "_comment_docker_reset_b": "========================================",
        "docker:reset": "npm run reset:db && npm run docker:setup",
        "reset:db": "wp-env clean all && wp-env start",
        "reset:env": "wp-env destroy && wp-env start",
        "update:env": "wp-env start -- --update",
        "restore:pages": "npm run wp-env run tests-cli -- bash -c \"wp post list --post_type=page --post_status=trash --format=ids | xargs -r -I {} wp post update {} --post_status=publish --post_author=2\"",

        "_comment_verification": "========================================",
        "_comment_verification_a": "VERIFICATION & DEBUGGING COMMANDS",
        "_comment_verification_b": "========================================",
        "check:pages": "npm run wp-env run tests-cli -- wp post list --post_type=page --fields=ID,post_title,post_status,post_author",
        "check:users": "npm run wp-env run tests-cli -- wp user list",
        "check:plugins": "npm run wp-env run tests-cli -- wp plugin list --status=active",
        "check:modules": "curl -s http://localhost:9999/?rest_route=/dokan/v1/admin/modules -u $(grep ADMIN= .env | cut -d= -f2):$(grep ADMIN_PASSWORD= .env | cut -d= -f2) | jq -r '.[] | select(.active == true) | .id' | wc -l | xargs echo 'Active modules:'",
        "docker:logs": "docker logs tests-wordpress-1 --tail=50",
        "docker:logs:cli": "docker logs tests-cli-1 --tail=50",
        "docker:testDbPort": "docker ps -f ancestor='mariadb' -f name='tests-mysql' --format='{{.Ports}}'",

        "_comment_local_setup": "========================================",
        "_comment_local_setup_a": "LOCAL SITE SETUP (Non-Docker)",
        "_comment_local_setup_b": "For local WordPress installations only",
        "_comment_local_setup_c": "========================================",
        "site:reset": "NO_SETUP=false npm run site:setup && npm run env:setup",
        "site:setup": "SKIP_DOKAN=true npx playwright test --project=local_site_setup",
        "env:setup": "NO_SETUP=true npx playwright test --project=e2e_setup",
        "auth:setup": "NO_SETUP=true npx playwright test --project=auth_setup",

        "_comment_utils": "========================================",
        "_comment_utils_a": "CODE QUALITY & UTILITIES",
        "_comment_utils_b": "========================================",
        "type": "npx tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prettier": "prettier . --check",
        "prettier:fix": "prettier . --write"
    },
    "keywords": [],
    "author": {
        "name": "Rajkumar Shashwata Halder",
        "email": "shashwatahalder01@gmail.com",
        "url": "https://github.com/shashwatahalder01"
    },
    "license": "ISC",
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.13.10",
        "@typescript-eslint/eslint-plugin": "^8.26.1",
        "@typescript-eslint/parser": "^8.26.1",
        "eslint": "9.22",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-playwright": "^2.2.0",
        "js-yaml": "^4.1.0",
        "npm-check-updates": "^17.1.15",
        "prettier": "^3.5.3",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^5.8.2"
    },
    "dependencies": {
        "@faker-js/faker": "^9.6.0",
        "@playwright/test": "1.51",
        "@wordpress/env": "^10.20.0",
        "dotenv": "^16.4.7",
        "mysql2": "^3.13.0",
        "php-serialize": "^5.1.2",
        "zod": "^3.24.2"
    }
}

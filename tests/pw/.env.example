# Admin Configuration (wp-env default admin credentials)
# For Docker/wp-env, use: admin / password / wordpress@example.com
# For local setup, replace with your admin credentials
ADMIN=admin
ADMIN_PASSWORD=password
ADMIN_EMAIL=wordpress@example.com

# Test Users
VENDOR=vendor1
VENDOR2=vendor2
CUSTOMER=customer1
CUSTOMER2=customer2
USER_PASSWORD=your_test_password

# Dokan Configuration
DOKAN_PRO=true                              # Set to false for Lite only
LICENSE_KEY=your_dokan_pro_license_key      # Required for Pro
GMAP=your_google_maps_api_key               # Optional

# Playwright Configuration
BASE_URL=http://localhost:9999
HEADLESS=false
CI=true
NO_SETUP=false                             # MUST be true for Docker

# Database Configuration (Docker wp-env defaults - DO NOT CHANGE)
DB_HOST_NAME=localhost
DB_USER_NAME=root
DB_USER_PASSWORD=password
DATABASE=tests-wordpress
DB_PORT=9998
DB_PREFIX=wp

# REST API - CRITICAL: Query string format for Docker!
SERVER_URL=http://localhost:9999/?rest_route=

# Test Data (auto-populated by setup scripts)
CUSTOMER_ID=
VENDOR_ID=
CUSTOMER2_ID=
VENDOR2_ID=

# Stripe Express (test keys — mirror CI secrets TEST_*_STRIPE_EXPRESS).
TEST_PUBLISH_KEY_STRIPE_EXPRESS=
TEST_SECRET_KEY_STRIPE_EXPRESS=
# Real connected sandbox accounts (acct_…) under the SAME platform as the keys — required for
# the live transfer/refund money assertions (SE-PAY/SE-REF). Leave empty to gate those (skipped).
STRIPE_EXPRESS_VENDOR1_ACCT=
STRIPE_EXPRESS_VENDOR2_ACCT=
# Set true in CI when the secrets are expected, so the preflight FAILS (not skips) if missing.
STRIPE_EXPRESS_REQUIRED=false

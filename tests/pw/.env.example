# Admin Configuration (NEW APPROACH - Creates additional admin, keeps default)
ADMIN=your_admin_username
ADMIN_PASSWORD=your_secure_password
ADMIN_EMAIL=admin@example.com

# Test Users
VENDOR=vendor1
VENDOR2=vendor2
CUSTOMER=customer1
CUSTOMER2=customer2
USER_PASSWORD=your_test_password

# Dokan Configuration
DOKAN_PRO=true                              # Set to false for Lite only
LICENSE_KEY=your_dokan_pro_license_key      # Required for Pro
GMAP=your_google_maps_api_key               # Optional

# Playwright Configuration
BASE_URL=http://localhost:9999
HEADLESS=false
CI=true                                     # MUST be true for Docker

# Database Configuration (Docker wp-env defaults - DO NOT CHANGE)
DB_HOST_NAME=localhost
DB_USER_NAME=root
DB_USER_PASSWORD=password
DATABASE=tests-wordpress
DB_PORT=9998
DB_PREFIX=wp

# REST API - CRITICAL: Query string format for Docker!
SERVER_URL=http://localhost:9999/?rest_route=

# Test Data (auto-populated by setup scripts)
CUSTOMER_ID=
VENDOR_ID=
CUSTOMER2_ID=
VENDOR2_ID=

            "size_guide_button_text_color": "#ffffff",
            "size_guide_measurement_unit": "furlongs",
            "size_guide_popup_background_color": "#ffffff",
            "size_guide_popup_text_color": "notacolor",
            "size_guide_popup_title": "",
            "size_guide_tab_background_color": "#ffffff",
            "unknown_printful_field": "__T_FAKE_UNKNOWN_001"
          }
        }
      }
    }
  }
}

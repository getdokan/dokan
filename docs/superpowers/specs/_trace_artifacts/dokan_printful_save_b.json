      "settingsData[printful_secret_key]": "",
      "settingsData[size_guide_popup_title]": "",
      "settingsData[size_guide_popup_text_color]": "notacolor",
      "settingsData[size_guide_popup_background_color]": "#ffffff",
      "settingsData[size_guide_tab_background_color]": "#ffffff",
      "settingsData[size_guide_active_tab_background_color]": "#7047eb",
      "settingsData[size_guide_button_text]": "<script>alert(1)</script>",

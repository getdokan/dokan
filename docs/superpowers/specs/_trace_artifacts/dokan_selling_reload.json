  "filter_validation_reloads": {
    "commission_type_empty_reload": {
      "stored_in_db": "(blank string `''` after save)",
      "GET_returns": "fixed",
      "verdict": "Confirmed: `set_commission_type_if_not_set` (priority 10 on `dokan_get_settings_values`) maps empty → 'fixed' on every read."
    },
    "new_seller_enable_selling_legacy_on_reload": {
      "stored_in_db": "on",
      "GET_returns": "automatically",
      "verdict": "Confirmed: `Settings::get_settings_value` runs `AdminSettings::get_new_seller_enable_selling_status('on')` which maps 'on'→'automatically'."
    },
    "new_seller_enable_selling_legacy_off_reload": {
      "stored_in_db": "off",
      "GET_returns_expected": "manually",
      "verdict": "By symmetry (mapper maps 'off'→'manually'); test not re-run after restoring Save A state."
    }
  }

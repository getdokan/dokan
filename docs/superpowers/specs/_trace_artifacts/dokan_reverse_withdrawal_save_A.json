{
  "request": {
    "method": "POST",
    "url": "/wp-admin/admin-ajax.php",
    "content_type": "application/x-www-form-urlencoded",
    "body": "action=dokan_save_settings&nonce=<window.dokan.nonce>&section=dokan_reverse_withdrawal&settingsData[enabled]=on&settingsData[payment_gateways][cod]=cod&settingsData[billing_type]=by_month&settingsData[reverse_balance_threshold]=4242&settingsData[monthly_billing_day]=15&settingsData[due_period]=10&settingsData[failed_actions][hide_withdraw_menu]=hide_withdraw_menu&settingsData[display_notice]=off"
  },
  "response": {
    "success": true,
    "data": {
      "message": "Setting has been saved successfully.",
      "settings": {
        "name": "dokan_reverse_withdrawal",
        "value": {
          "enabled": "on",
          "payment_gateways": { "cod": "cod" },
          "billing_type": "by_month",
          "reverse_balance_threshold": "4242",
          "monthly_billing_day": "15",
          "due_period": "10",
          "failed_actions": { "hide_withdraw_menu": "hide_withdraw_menu" },
          "display_notice": "off",
          "dashboard_menu_manager": []
        }
      }
    }
  },
  "side_effects": {
    "action_scheduler_pending": [
      "dokan_reverse_withdrawal_midnight_cron @ 2026-05-15 18:00:00 (daily, scheduled when enabled=on)",
      "dokan_reverse_withdrawal_monthly_cron @ 2026-05-15 08:00:00 (cron '0 8 15 * *', scheduled when enabled=on AND billing_type=by_month)"
    ]
  }
}

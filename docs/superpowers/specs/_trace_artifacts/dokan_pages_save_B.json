{
  "request": {
    "method": "POST",
    "url": "/wp-admin/admin-ajax.php",
    "content_type": "application/x-www-form-urlencoded",
    "body": "action=dokan_save_settings&nonce=<window.dokan.nonce>&section=dokan_pages&settingsData[dashboard]=0&settingsData[my_orders]=0&settingsData[store_listing]=999999&settingsData[reg_tc_page]=0&settingsData[vendor_onboarding]=0"
  },
  "response": {
    "success": true,
    "data": {
      "message": "Setting has been saved successfully.",
      "settings": {
        "name": "dokan_pages",
        "value": {
          "dashboard": "0",
          "dashboard_menu_manager": [],
          "my_orders": "0",
          "reg_tc_page": "0",
          "store_listing": "999999",
          "vendor_onboarding": "0"
        }
      }
    }
  },
  "notes": {
    "page_id_zero": "Accepted without validation — coerced to string '0', round-trips into DB",
    "non_existent_id_999999": "Accepted without validation — stored as '999999' literally, no existence check"
  }
}
